{
	"info": {
		"_postman_id": "ums-api-v1-collection",
		"name": "UMS.API | v1",
		"description": "Postman collection for UMS.API v1 - User Management System. Import this file into Postman to test all endpoints.\n\n**Variables:**\n- `base_url`: The API base URL (default: https://localhost:7122)\n- `version`: API version (default: 1)\n- `token`: JWT token (set after login)\n- `refresh_token`: Refresh token (set after login)\n\n**Usage:**\n1. Run the **Login** request first to populate `token` and `refresh_token`.\n2. All authenticated requests will automatically use the Bearer token.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Account",
			"description": "Account management endpoints: login, token refresh, password reset, email confirmation, 2FA login, logout, and profile.",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"P@ssw0rd!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v{{version}}/account/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v{{version}}",
								"account",
								"login"
							]
						},
						"description": "Authenticate a user and receive a JWT token + refresh token. On success, the response includes `token`, `refreshToken`, and `refreshTokenExpiryTime`. If 2FA is enabled, `requiresTwoFactor` will be `true` with a `twoFactorChallengeToken`."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.isSuccessful && res.data) {",
									"    pm.collectionVariables.set('token', res.data.token);",
									"    pm.collectionVariables.set('refresh_token', res.data.refreshToken);",
									"    pm.collectionVariables.set('two_factor_challenge_token', res.data.twoFactorChallengeToken || '');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{token}}\",\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v{{version}}/account/refresh-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v{{version}}",
								"account",
								"refresh-token"
							]
						},
						"description": "Refresh an expired JWT token using a valid refresh token."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.isSuccessful && res.data) {",
									"    pm.collectionVariables.set('token', res.data.token);",
									"    pm.collectionVariables.set('refresh_token', res.data.refreshToken);",
									"}"
								]
							}
						}
					]
				},
